# true  = run entirely on built-in fake data (no backend needed)
# false = talk to the FastAPI backend
VITE_USE_MOCK=true

# Where the dev server forwards /api, /ws and /files (backend address)
VITE_PROXY_TARGET=http://localhost:8000

# Optional overrides (leave empty for local dev)
# VITE_API_BASE=/api
# VITE_WS_BASE=ws://localhost:8000/ws
