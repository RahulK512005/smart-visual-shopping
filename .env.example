# Application Settings
APP_NAME="Smart Visual Shopping API"
APP_ENV=development
DEBUG=true
API_V1_STR=/api
HOST=0.0.0.0
PORT=8000

# Database
# Local SQLite default: sqlite:///./smart_visual_shopping.db
# PostgreSQL example: postgresql+psycopg2://user:password@localhost:5432/smart_visual_shopping
DATABASE_URL=sqlite:///./smart_visual_shopping.db

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# AI/ML Visual Search Service Integration Boundary
# The ML service is run by the AI/ML engineer exposing POST /internal/search
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TIMEOUT_SECONDS=5.0
ML_SERVICE_CONNECT_TIMEOUT_SECONDS=2.0

# Upload Limits
MAX_UPLOAD_SIZE_BYTES=10485760 # 10MB
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif
